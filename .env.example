# MEDUSA-X configuration.
# Copy to .env (Windows: copy .env.example .env) and adjust.
# Only the optional LLM key (MEDUSA_LLM_API_KEY) is secret. Never commit .env.

# ---- Backend (FastAPI) ----
# development | test | production   (production disables /docs)
MEDUSA_ENVIRONMENT=development
MEDUSA_API_HOST=127.0.0.1
MEDUSA_API_PORT=8000
# Auto-reload on code changes. Development only.
MEDUSA_RELOAD=true

# Relative paths are resolved from the project root.
MEDUSA_DB_PATH=data/medusa.db

# Document ingestion. Original uploads are stored here under generated names.
MEDUSA_UPLOAD_DIR=data/uploads
MEDUSA_DEMO_DIR=data/demo
# Maximum upload size in bytes (5 MB).
MEDUSA_MAX_UPLOAD_BYTES=5000000
MEDUSA_MAX_PDF_PAGES=50
# Extracted text shorter than this (after trimming) is rejected as insufficient.
MEDUSA_MIN_TEXT_CHARS=20

# ---- Optional LLM extraction (Phase 3) ----
# Rules always run. With a provider set, the LLM proposes extra claims; each is kept only if its quote
# appears word for word in the source passage. If the LLM fails, the run completes with rule claims only
# and says so. Check the connection with:  cd backend  then  python -m medusa.analysis.llm.check
# none | anthropic | openai_compatible   (openai_compatible also covers local servers such as Ollama)
MEDUSA_LLM_PROVIDER=none
# e.g. claude-haiku-5-5 for anthropic; your model's name for openai_compatible
MEDUSA_LLM_MODEL=
# Put your key in .env only. Never commit it. Optional for local openai_compatible servers.
MEDUSA_LLM_API_KEY=
# Empty = provider default (https://api.anthropic.com or https://api.openai.com/v1).
# Ollama example: http://127.0.0.1:11434/v1
MEDUSA_LLM_BASE_URL=
MEDUSA_LLM_TIMEOUT_SECONDS=45
MEDUSA_LLM_MAX_RETRIES=2

# DEBUG | INFO | WARNING | ERROR | CRITICAL
MEDUSA_LOG_LEVEL=INFO
# text | json
MEDUSA_LOG_FORMAT=text
# Leave empty to log to the console only.
MEDUSA_LOG_FILE=

# ---- Frontend (React, Vite dev server) ----
# The Vite dev server reads MEDUSA_API_HOST and MEDUSA_API_PORT above to proxy /api to the backend.
# No separate frontend setting is needed.

# ---- Single-process demo (Phase 11) ----
# true = the backend also serves the built UI (run `npm run build` in frontend first) at http://127.0.0.1:8000.
# Leave false for development (Vite on 5173). The VS Code task "Demo: single process" sets it for you.
MEDUSA_SERVE_FRONTEND=false
